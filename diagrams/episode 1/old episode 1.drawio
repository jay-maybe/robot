        <mxCell id="iGQFTnq-l8ZYcF4gNrbN-0" parent="q_p_FpAMMq0ceSiXkxiK-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot; face=&quot;Space Mono&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 24px;&quot; face=&quot;Space Mono&quot;&gt;&lt;b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;My son, eat honey, for it is good, and the drippings of the honeycomb &lt;br&gt;are sweet to your taste.&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot; face=&quot;Space Mono&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot; face=&quot;Space Mono&quot;&gt;&lt;b&gt;Know that wisdom is such to your soul; if you &lt;br&gt;find it, there will be a future, and your hope will not be cut off.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot; face=&quot;Space Mono&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot; face=&quot;Space Mono&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;h2 class=&quot;text-text-light dark:text-text-dark font-bold font-aktiv-grotesk&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot; face=&quot;Space Mono&quot;&gt;Proverbs 24:13-14 ESV&lt;/font&gt;&lt;/h2&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
